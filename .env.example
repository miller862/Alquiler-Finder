# Copia este archivo como .env y completa con tus valores reales.
# NUNCA commitees el .env al repositorio.

# ─── Base de datos ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://deptos:TU_PASSWORD@localhost:5432/deptos_scraper
SYNC_DATABASE_URL=postgresql+psycopg2://deptos:TU_PASSWORD@localhost:5432/deptos_scraper

# ─── Seguridad ─────────────────────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=reemplazar-con-clave-secreta-de-64-caracteres-hexadecimales
ACCESS_TOKEN_EXPIRE_SECONDS=28800

# ─── Google Maps ───────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=tu-api-key-de-google-maps

# ─── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
DOCKER_ENV=false
ALLOWED_ORIGINS=["http://localhost:8000"]
SHAPES_DIR=shapes

# ─── ZonaProp (Cloudflare) ──────────────────────────────────────────────────────
# UA e impersonate del navegador con el que sacas la cookie cf_clearance.
# Default: Brave/Chrome 149 en Windows. Ver docs/zonaprop_cookie.md
# ZONAPROP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/149.0.0.0 Safari/537.36
# ZONAPROP_IMPERSONATE=chrome146
